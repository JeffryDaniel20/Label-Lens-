# Copy to backend/.env for local runs. Never commit a filled-in .env.
LABELLENS_ENVIRONMENT=local
LABELLENS_DEBUG=true
# Minimum 32 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LABELLENS_SECRET_KEY=replace-me-with-a-long-random-value-at-least-32-chars
LABELLENS_DATABASE_URL=postgresql+psycopg://labellens:labellens@localhost:5432/labellens
LABELLENS_REDIS_URL=redis://localhost:6379/0
LABELLENS_COOKIE_SECURE=false
LABELLENS_CORS_ORIGINS=["http://localhost:5173"]
