# Copy to backend/.env for local runs. Never commit a filled-in .env.
LABELLENS_ENVIRONMENT=local
LABELLENS_DEBUG=true
# Minimum 32 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LABELLENS_SECRET_KEY=replace-me-with-a-long-random-value-at-least-32-chars
LABELLENS_DATABASE_URL=postgresql+psycopg://labellens:labellens@localhost:5432/labellens
LABELLENS_REDIS_URL=redis://localhost:6379/0
LABELLENS_COOKIE_SECURE=false
LABELLENS_CORS_ORIGINS=["http://localhost:5173"]

# --- LLM extraction (D-06: Gemini) ---
# Provider-neutral on purpose: switching vendors is a config change, not a
# code change. Get a Gemini key from https://aistudio.google.com/apikey
# Leave LABELLENS_LLM_API_KEY empty to run without extraction (the pipeline
# fails that stage explicitly rather than inventing facts).
LABELLENS_LLM_PROVIDER=gemini
LABELLENS_LLM_API_KEY=
# Pinned, not a floating alias: reproducibility is a product requirement.
# Escalation points at the same model because Pro tiers need billing enabled
# (see app/platform/config.py); set it to a Pro model once billing is on.
LABELLENS_LLM_MODEL=gemini-3.8-flash
LABELLENS_LLM_ESCALATION_MODEL=gemini-3.8-flash
