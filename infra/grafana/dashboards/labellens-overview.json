{
  "title": "LabelLens Overview",
  "uid": "labellens-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Analyses by state",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "labellens_analyses_by_state", "legendFormat": "{{state}}"}
      ]
    },
    {
      "id": 2,
      "title": "DLQ unreplayed",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "labellens_dlq_unreplayed"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Analysis failure rate (15m)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "rate(labellens_analysis_failures_total[15m])", "legendFormat": "{{stage}}"}
      ]
    },
    {
      "id": 4,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "labellens_queue_depth", "legendFormat": "{{queue}}"}
      ]
    },
    {
      "id": 5,
      "title": "Stage duration p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(labellens_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "DLQ arrivals by reason",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "rate(labellens_dlq_arrivals_total[15m])", "legendFormat": "{{reason}}"}
      ]
    }
  ]
}
